import java.util.*;

class stack {
    public static void pushAtbottom(Stack<Integer> s, int data) {
        if (s.isEmpty()) {
            s.push(data);
            return;
        }
        int temp = s.pop();
        pushAtbottom(s,data);
        s.push(temp);
    }


    public static void main(String[] args) {
        Stack<Integer> s = new Stack<>();
        s.push(1);
        s.push(2);
        s.push(3);

        pushAtbottom(s, 4);


        while(!s.isEmpty()){
            System.out.println(s.pop());
        }

    }
}
