import java.util.*;
class Solution {
    public static int binarysearch(int[] arr, int k) {
        // Code Here

        int l = 0;
        int r = arr.length-1;
        
        while(l <= r){
            int m = l + (r-l) / 2;
            
            if(arr[m] == k)    return m;
            else if(arr[m] < k )   l = m+1;
            else r = m-1;
            
               }
        return -1;
        
    }
    public static void main (String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        
        int[] arr = new int[n];
        
        for(int i=0; i<n; i++){
            arr[i] = sc.nextInt();
        }
        
        int k = sc.nextInt();
        
        binarysearch(arr,k);
    }
}
